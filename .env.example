# Required — your Opencals storefront API key. This site calls the API from its server, so use a private
# storefront key (spk_): it stays secret and gives each visitor their own rate limits (lib/opencals.ts).
# A public key (sfk_) also works, but then all visitors share your server's limits.
OPENCALS_API_KEY=spk_your_key_here

# Optional — override API base URL (defaults to https://api.opencals.com)
# OPENCALS_API_URL=https://api.opencals.com

# Required for auth — random secret for session encryption (e.g. `openssl rand -base64 32`)
AUTH_SECRET=change_me_to_a_random_string

# NOTE: The public site URL used for the sitemap, canonical URLs and Open Graph
# comes from `url` in lib/site-config.ts, not from an env var.
#
# Passwordless login codes and one-time email links (/link/[token]) work out
# of the box. For emailed links to point back to this app, set "Storefront Base URL"
# in your Opencals dashboard (Settings → API) to your deployed URL.
